# Copy names into an approved secret manager. Never commit real values.
BACKUP_PLATFORM_AUTHORITY=verified_super_admin
BACKUP_PRODUCTION_CONFIRMATION=EXPORT PRODUCTION TO APPROVED DESTINATION
BACKUP_DESTINATION=s3
BACKUP_ENCRYPTION_KEY=base64-encoded-32-byte-key-from-secret-manager
BACKUP_S3_BUCKET=approved-independent-backup-bucket
BACKUP_S3_PREFIX=transport-platform
BACKUP_S3_ENDPOINT=
AWS_REGION=eu-west-2
AWS_ACCESS_KEY_ID=secret-manager-value
AWS_SECRET_ACCESS_KEY=secret-manager-value
AWS_CLI_PATH=aws
PGHOST=production-database-host
PGPORT=5432
PGDATABASE=postgres
PGUSER=approved-backup-role
PGPASSWORD=secret-manager-value
PGSSLMODE=require
SUPABASE_URL=https://project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=secret-manager-value
BACKUP_STORAGE_PAGE_SIZE=100
BACKUP_DOWNLOAD_CONCURRENCY=2
BACKUP_MAXIMUM_AGE_HOURS=30
BACKUP_FAILURE_WEBHOOK_URL=
