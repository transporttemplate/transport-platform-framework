<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="uk.co.transportplatform.gateway" android:versionCode="6" android:versionName="6.0.0">
 <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="35" />
