# Configure these with `supabase secrets set`; never commit real values.
EMAIL_PROVIDER_API_KEY=replace-in-Supabase-secrets
EMAIL_FROM_ADDRESS=Bookings <bookings@your-verified-domain.example>
# Optional. Defaults to the Resend-compatible endpoint below.
EMAIL_PROVIDER_URL=https://api.resend.com/emails

# Supabase provides these automatically to deployed Edge Functions:
# SUPABASE_URL
# SUPABASE_SERVICE_ROLE_KEY
