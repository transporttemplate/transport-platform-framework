# Configure these with `supabase secrets set`; never commit real values.
EMAIL_PROVIDER_API_KEY=replace-in-Supabase-secrets
EMAIL_FROM_ADDRESS=Bookings <bookings@your-verified-domain.example>
# Optional. Defaults to the Resend-compatible endpoint below.
EMAIL_PROVIDER_URL=https://api.resend.com/emails

# Google Calendar service account credentials. Keep the private key in Supabase secrets.
GOOGLE_SERVICE_ACCOUNT_EMAIL=calendar-service-account@your-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nreplace-in-Supabase-secrets\n-----END PRIVATE KEY-----\n

# Company-scoped Google Routes server keys. Browser Maps keys stay in each
# company's settings row and must never be copied between tenants.
GOOGLE_ROUTES_API_KEY_0001=replace-in-Supabase-secrets
GOOGLE_ROUTES_API_KEY_0002=replace-in-Supabase-secrets

# Admin payment links accept Stripe test credentials only.
STRIPE_SECRET_KEY_0001=sk_test_replace-in-Supabase-secrets
STRIPE_WEBHOOK_SECRET_0001=whsec_replace-in-Supabase-secrets
PUBLIC_SITE_URL=https://your-approved-public-origin.example

# Supabase provides these automatically to deployed Edge Functions:
# SUPABASE_URL
# SUPABASE_SERVICE_ROLE_KEY
